// قاعدة بيانات Melty Cake
// ملاحظة: SQLite لا يدعم Prisma enums، لذلك تُستخدم حقول String لكل ما هو
// "حالة/نوع" (status/type)، مع التحقق منها في lib/validation.ts و lib/constants.ts.
// الانتقال لاحقاً إلى PostgreSQL: غيّر provider أدناه إلى "postgresql" وحدّث DATABASE_URL.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============== العملاء ==============

model User {
  id            Int            @id @default(autoincrement())
  name          String
  phone         String         @unique
  email         String?
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  favorites     Favorite[]
  orders        Order[]
  notifications Notification[]
  couponUsages  CouponUsage[]
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String?
  governorate String?
  district    String?
  area        String?
  detail      String
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============== الكتالوج ==============

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  image     String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id               Int                  @id @default(autoincrement())
  name             String
  slug             String               @unique
  description      String?
  basePrice        Int // بالدينار العراقي، بدون كسور
  categoryId       Int
  category         Category             @relation(fields: [categoryId], references: [id])
  isFeatured       Boolean              @default(false)
  isBestSeller     Boolean              @default(false)
  isAvailable      Boolean              @default(true)
  allowCakeMessage Boolean              @default(false) // كتابة عبارة على الكيك
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  images           ProductImage[]
  optionGroups     ProductOptionGroup[]
  favorites        Favorite[]
  orderItems       OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
}

// مجموعة خيارات (مثال: الحجم / النكهة / الإضافات)
model ProductOptionGroup {
  id         Int                  @id @default(autoincrement())
  productId  Int
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  type       String // 'SINGLE' (اختيار واحد) أو 'MULTI' (عدة اختيارات)
  priceMode  String // 'OVERRIDE' (يحدد السعر) أو 'DELTA' (يضاف على السعر الأساسي)
  isRequired Boolean              @default(true)
  sortOrder  Int                  @default(0)
  values     ProductOptionValue[]
}

model ProductOptionValue {
  id          Int                @id @default(autoincrement())
  groupId     Int
  group       ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label       String
  description String?
  price       Int                @default(0)
  isDefault   Boolean            @default(false)
  sortOrder   Int                @default(0)
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============== الطلبات ==============

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int?
  user            User?         @relation(fields: [userId], references: [id])
  customerName    String
  customerPhone   String
  governorate     String?
  district        String?
  detailedAddress String
  deliveryNotes   String?
  deliveryZoneId  Int?
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  subtotal        Int
  deliveryFee     Int
  discount        Int           @default(0)
  total           Int
  couponId        Int?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  paymentMethod   String        @default("CASH_ON_DELIVERY")
  status          String        @default("RECEIVED")
  // رمز وصول عشوائي يسمح لضيف (بدون حساب) بمتابعة طلبه عبر رابط مباشر
  // بدون كشف أرقام الطلبات المتسلسلة لأي شخص آخر
  trackingToken   String        @unique
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// سطر الطلب يحفظ "لقطة" (Snapshot) من السعر والاسم والخيارات وقت الطلب
// حتى لو تغيّر سعر المنتج لاحقاً، لا يتأثر الطلب القديم
model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int?
  product         Product? @relation(fields: [productId], references: [id])
  productName     String
  unitPrice       Int
  quantity        Int
  selectedOptions Json // [{ groupName, valueLabel, price }]
  cakeMessage     String?
  note            String?
  lineTotal       Int
}

// ============== العروض والخصومات ==============

model Coupon {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  type           String // 'PERCENTAGE' أو 'FIXED'
  value          Int
  minOrderAmount Int           @default(0)
  usageLimit     Int?
  usedCount      Int           @default(0)
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  usages         CouponUsage[]
  orders         Order[]
}

model CouponUsage {
  id        Int      @id @default(autoincrement())
  couponId  Int
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  orderId   Int?
  createdAt DateTime @default(now())
}

model Banner {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  image       String?
  linkUrl     String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
}

// ============== التوصيل ==============

model DeliveryZone {
  id             Int     @id @default(autoincrement())
  name           String
  fee            Int
  minOrderAmount Int     @default(0)
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  orders         Order[]
}

// ============== الإشعارات ==============

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============== إعدادات المشروع ==============

// صف واحد فقط (id = 1) يحمل كل إعدادات المشروع القابلة للتعديل من لوحة التحكم
model BusinessSettings {
  id                    Int      @id @default(1)
  name                  String   @default("Melty Cake")
  logo                  String?
  description           String?
  phone                 String?
  whatsapp              String?
  secondPhone           String?
  instagramUrl          String?
  facebookUrl           String?
  address               String?
  workingHours          String?
  currency              String   @default("IQD")
  welcomeMessage        String?
  freeDeliveryThreshold Int?
  updatedAt             DateTime @updatedAt
}

// ============== الأدمن ==============

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  adminName String?
  action    String
  entity    String?
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())
}
