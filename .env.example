# ===== قاعدة البيانات =====
# للتطوير المحلي: SQLite (لا يحتاج إعداد إضافي)
DATABASE_URL="file:./dev.db"
# للإنتاج على Postgres (مثال، غيّر القيمة الفعلية وغيّر provider في prisma/schema.prisma إلى "postgresql"):
# DATABASE_URL="postgresql://user:password@host:5432/meltycake?schema=public"

# ===== الأمان =====
# مفتاح سري لتوقيع جلسات الدخول (عملاء + أدمن). غيّره لقيمة عشوائية طويلة قبل النشر.
# يمكنك توليد واحد بالأمر: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-long-random-string-before-deploying"

# ===== إنشاء أول حساب أدمن (اختياري - عبر seed) =====
# إذا تركتها فارغة، استخدم بدلاً منها الأمر: npm run create-admin
FIRST_ADMIN_NAME=""
FIRST_ADMIN_PHONE=""
FIRST_ADMIN_PASSWORD=""

# ===== إعدادات عامة =====
NODE_ENV="development"
